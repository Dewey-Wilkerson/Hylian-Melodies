# Hylian Melodies: a native Linux build of YOUR OWN copy of Cadence of Hyrule, made on this machine.
#
# PERSONAL USE ONLY. The package this builds contains the game, made from your cartridge dump: never share it.
#
# Put these next to this PKGBUILD (symlinks are fine):
#   cadence-base.xci   your cartridge dump (it carries the game, the 1.4.0 update and all four DLC packs)
#   prod.keys          your console's keys
# Then run `makepkg -si` (or `makepkg` to build only). Any terminal works: nothing is shown during the build.
#
# Disk: the package holds about 2 GiB of game data; makepkg keeps a build copy, the package and (after
# installing) the installed copy, so count on about 3 times that, plus about 2 GiB of temporary files during the
# build, on the disk of this folder. `makepkg -sic` deletes the build copy after installing.
# Time: about 5-10 minutes (most of it compiling the game code), more on a slower CPU.
#
# Where things go: the game in /opt/hylian-melodies (read-only, shared), the `hylian-melodies` command, a menu
# entry; each player's saves, settings, logs and caches in ${XDG_DATA_HOME:-~/.local/share}/hylian-melodies.
#
# HM_REPO=<path or URL> builds from another checkout of the project than the one this file lives in.

pkgname=hylian-melodies-recomp
pkgver=0.1.0.r17.g124d768
pkgrel=1
pkgdesc='Native Linux build of your own Cadence of Hyrule (static recompilation; personal use only)'
arch=(x86_64)
url='https://localhost/hylian-melodies'  # (no public home yet)
license=(MIT)
depends=(glibc gcc-libs sdl3 ffmpeg shaderc vulkan-icd-loader vulkan-driver)
makedepends=(git python python-lz4 clang lld ninja make gcc vulkan-headers vulkan-memory-allocator imagemagick)
optdepends=('xdg-user-dirs: a desktop shortcut in the right folder'
            'fontconfig: the menu finds a system font (else a built-in one)')
options=(!strip !debug !lto !buildflags)
install=hylian-melodies-recomp.install
PKGEXT='.pkg.tar'  # (gigabytes of already-compressed game data: compressing again only costs time)

_repo=${HM_REPO:-$(realpath "$startdir/../..")}
# CPU level of the game: v2 runs on any x86-64 CPU since ~2009 (default); v3 or native optimize for this computer
# only (HM_MARCH=v3 makepkg)
_march=${HM_MARCH:-v2}
source=("hylian-melodies::git+file://$_repo"
        'cadence-base.xci'
        'prod.keys')
noextract=('cadence-base.xci' 'prod.keys')
# The game files are checked by the setup itself against the known hashes of the official files (installer/known.py);
# anything else is refused, so makepkg's own sums are skipped for them.
sha256sums=('SKIP' 'SKIP' 'SKIP')

pkgver() {
    cd "$srcdir/hylian-melodies"
    local v
    v=$(cat VERSION)
    if git describe --tags --exact-match >/dev/null 2>&1; then
        git describe --tags | sed 's/^v//; s/-/./g'
    else
        printf '%s.r%s.g%s\n' "$v" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

prepare() {
    cd "$srcdir/hylian-melodies"
    git checkout -q --detach HEAD
    # fail early, not after the long part
    for f in cadence-base.xci prod.keys; do
        [ -e "$srcdir/$f" ] || { error "$f is missing: put it next to the PKGBUILD"; return 1; }
    done
    # hactool from its pinned upstream commit (tools/build_hactool.py fetches it now, so build() is offline)
    python tools/build_hactool.py --src "$srcdir/toolchain/src/hactool" --out "$srcdir/toolchain/hactool"
    # Dear ImGui (the overlay menu) at its pinned commit, fetched now for the same reason
    python tools/fetch_imgui.py --src "$srcdir/toolchain/src/imgui"
}

build() {
    # makepkg's flags are for packaging: the game build sets its own -march (_march above)
    unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
    export PYTHONDONTWRITEBYTECODE=1

    # events.py: the setup prints one JSON event per line; this turns them into readable lines (with the setup's own
    # messages) and fails the build unless the setup ends with "ok". Full log: $srcdir/install-temp/run-*/logs/.
    cat > "$srcdir/events.py" <<'PY'
import json, sys
sys.path.insert(0, sys.argv[1])
from installer.messages import STEPS
result = None
for line in sys.stdin:
    try:
        ev = json.loads(line)
    except ValueError:
        print(line.rstrip(), flush=True)
        continue
    k = ev.get('event')
    if k == 'step':
        print(f"==> {ev.get('msg', ev.get('step'))}", flush=True)
    elif k == 'progress':
        p = ev.get('pct', 0)
        if p % 10 == 0:
            print(f"    {STEPS.get(ev['step'], ev['step'])}: {p}%", flush=True)
    elif k in ('info', 'warning', 'error'):
        print(f"    {k if k != 'info' else ''}{': ' if k != 'info' else ''}{ev.get('text', ev.get('msg'))}", flush=True)
    elif k == 'end':
        result = ev.get('result')
        print(f"==> setup {result}", flush=True)
sys.exit(0 if result == 'ok' else 1)
PY

    mkdir -p "$srcdir/stage"
    # Resumes a staging folder left by an interrupted or failed build. "Recompiling" and "Compiling" sit at a few
    # percent for a while on slower machines: generating the C, then the largest files compile first.
    cd "$srcdir/hylian-melodies"
    python -m installer --base "$srcdir/cadence-base.xci" --keys "$srcdir/prod.keys" \
        --dest "$srcdir/stage/hylian-melodies" --temp "$srcdir/install-temp" --root "$srcdir/hylian-melodies" \
        --hactool "$srcdir/toolchain/hactool/hactool" --imgui "$srcdir/toolchain/src/imgui" --march "$_march" | python "$srcdir/events.py" "$srcdir/hylian-melodies"

    # the menu icon: the game's own (from your cartridge's control data, extracted by the setup), else the project's
    if [ -f "$srcdir/stage/hylian-melodies/icon.jpg" ]; then
        magick "$srcdir/stage/hylian-melodies/icon.jpg" -resize 256x256 "$srcdir/hylian-melodies.png"
    else
        magick -background none packaging/hylian-melodies.svg -resize 256x256 "$srcdir/hylian-melodies.png"
    fi
}

package() {
    local stage="$srcdir/stage/hylian-melodies" game="$pkgdir/opt/hylian-melodies"
    local support="$pkgdir/usr/share/hylian-melodies-recomp" repo="$srcdir/hylian-melodies"

    # the game, read-only and shared (hard links: no extra space; the staging folder stays whole for makepkg -R)
    install -d "$pkgdir/opt"
    cp -al "$stage" "$game"
    # per-player things never ship: the setup's record, saves, settings, logs, caches
    rm -f "$game/hm-install.json"
    rm -rf "$game/profile" "$game/logs" "$game/cache" "$game/build"
    rm -f "$game/hylian-melodies.ini" "$game/icon.jpg"  # (the icon went to the desktop entry, build())

    # the executable without debug info (a copy first: the staged file is a hard link). Crash reports name host
    # functions from its dynamic symbols, which stay.
    cp "$game/hylian-melodies" "$game/hylian-melodies.strip"
    strip --strip-debug "$game/hylian-melodies.strip"
    mv -f "$game/hylian-melodies.strip" "$game/hylian-melodies"

    # nothing may name the build directory (the game finds its data next to its own executable)
    local bad
    bad=$(grep -rlIF -- "$srcdir" "$pkgdir" || true)
    if [ -n "$bad" ]; then
        error "files name the build directory:"; printf '  %s\n' $bad; return 1
    fi
    if grep -qF -- "$srcdir" "$game/hylian-melodies"; then
        warning "the game executable contains the build directory's path (debug data?)"
    fi

    chown -R root:root "$game"
    chmod -R u+w,go+rX,go-w "$game"

    install -Dm755 "$repo/packaging/arch/hylian-melodies.sh" "$pkgdir/usr/bin/hylian-melodies"
    install -Dm644 "$srcdir/hylian-melodies.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/hylian-melodies.png"
    install -Dm644 "$repo/packaging/arch/hylian-melodies.desktop" "$pkgdir/usr/share/applications/hylian-melodies.desktop"
    install -Dm644 "$repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$repo/packaging/hylian-melodies.ini" "$support/hylian-melodies.ini"

    # where the post-install hook puts a desktop shortcut for the person who built the package (not a package file:
    # the desktop folder is theirs)
    local desk
    desk=$(xdg-user-dir DESKTOP 2>/dev/null || true)
    if [ -z "$desk" ] || [ "$desk" = "$HOME" ]; then desk=$HOME/Desktop; fi
    install -d "$support"
    printf '%s\n' "$desk/hylian-melodies.desktop" > "$support/desktop-copy"
}
